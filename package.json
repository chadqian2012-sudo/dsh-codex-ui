{
  "name": "dsh-codex-ui",
  "version": "1.2.1",
  "description": "DeepSeek Harness 的 Codex 风格模型弹窗，七档界面映射原生四档及可交互星尘 / Codex-style DSH model and effort menus",
  "license": "MIT",
  "author": "chadqian2012-sudo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chadqian2012-sudo/dsh-codex-ui.git"
  },
  "homepage": "https://github.com/chadqian2012-sudo/dsh-codex-ui#readme",
  "bugs": {
    "url": "https://github.com/chadqian2012-sudo/dsh-codex-ui/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "reasoning-effort",
    "slider",
    "ui"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "install-profile.ps1",
    "pack-dist.ps1",
    "install.cmd",
    "INSTALL.md",
    "VALIDATION.md",
    "PUBLISHING.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "preview/screenshots/v1.2.0/overview.png",
    "preview/screenshots/v1.2.0/light-low.png",
    "preview/screenshots/v1.2.0/light-high.png",
    "preview/screenshots/v1.2.0/light-max.png",
    "preview/screenshots/v1.2.0/dark-max.png",
    "preview/screenshots/v1.2.0/light-high-boost.png",
    "preview/screenshots/v1.2.0/dark-high-boost.png",
    "preview/screenshots/v1.2.0/light-ultra-boost.png",
    "preview/screenshots/v1.2.0/dark-ultra-boost.png",
    "preview/screenshots/v1.2.0/light-models.png",
    "preview/screenshots/v1.2.0/dark-models.png",
    "README.md"
  ],
  "scripts": {
    "test": "node test/client.test.mjs",
    "preview": "node test/browser-fixture.mjs",
    "test:browser": "node test/browser-ui.test.mjs",
    "preview:capture": "node test/capture-preview.mjs",
    "test:native": "node test/native-contract.mjs",
    "test:asar": "node --test test/asar.test.mjs",
    "test:install": "powershell -NoProfile -ExecutionPolicy Bypass -File test/install.test.ps1",
    "test:distribution": "node --test test/distribution.test.mjs",
    "test:publish": "powershell -NoProfile -ExecutionPolicy Bypass -File test/publish.test.ps1",
    "test:zip": "powershell -NoProfile -ExecutionPolicy Bypass -File test/zip.test.ps1",
    "pack": "powershell -NoProfile -ExecutionPolicy Bypass -File ./pack-dist.ps1",
    "prepublishOnly": "npm test && npm run test:distribution"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
